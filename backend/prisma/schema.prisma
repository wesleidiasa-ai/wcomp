generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  cnpj                String?
  phone               String?
  email               String?
  addressStreet       String?  @map("address_street")
  addressNumber       String?  @map("address_number")
  addressComplement   String?  @map("address_complement")
  addressNeighborhood String?  @map("address_neighborhood")
  addressCity         String?  @map("address_city")
  addressState        String?  @map("address_state") // UF, ex: "GO"
  addressZipCode      String?  @map("address_zip_code")
  plan                String   @default("trial") // trial, basico, pro
  whatsappPhoneNumberId String? @unique @map("whatsapp_phone_number_id") // phone_number_id do WhatsApp Business desta empresa, usado pra rotear o webhook
  createdAt           DateTime @default(now()) @map("created_at")

  departments      Department[]
  users            User[]
  approvalRules    ApprovalRule[]
  purchaseRequests PurchaseRequest[]
  suppliers        Supplier[]
  whatsappSessions WhatsAppSession[]

  @@map("companies")
}

// Catálogo de fornecedores da empresa
model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  cnpj      String?
  phone     String?
  email     String?
  rating    Int? // avaliação manual do comprador, 1 a 5
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])
  quotes  Quote[]

  @@unique([companyId, name])
  @@map("suppliers")
}

model Department {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  name      String // ex: "Manutenção", "Agrícola", "Administrativo"

  company Company @relation(fields: [companyId], references: [id])

  users            User[]
  approvalRules    ApprovalRule[]
  purchaseRequests PurchaseRequest[]

  @@map("departments")
}

// admin, comprador, solicitante, aprovador
model User {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  departmentId String?  @map("department_id") @db.Uuid
  name         String
  email        String   @unique
  phone        String? // pra WhatsApp
  role         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  company    Company     @relation(fields: [companyId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  approvalRulesAsApprover ApprovalRule[]    @relation("RuleApprover")
  purchaseRequestsCreated PurchaseRequest[] @relation("Requester")
  approvalStepsAsApprover ApprovalStep[]    @relation("StepApprover")
  approvalStepsDecided    ApprovalStep[]    @relation("StepDecidedBy")
  statusChangesMade       StatusHistory[]
  notifications           Notification[]
  quotesRegistered        Quote[]
  attachmentsUploaded     QuoteAttachment[]
  whatsappSessions        WhatsAppSession[]

  @@map("users")
}

// Estado da conversa do bot de intake de pedidos via WhatsApp, por empresa + telefone.
// Escopado por empresa porque o mesmo número de telefone poderia, em tese, existir
// cadastrado em duas empresas diferentes — cada uma com seu próprio WhatsApp Business.
model WhatsAppSession {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  phone     String // dígitos apenas, formato do wa_id da Meta (ex: 5511999998888)
  userId    String?  @map("user_id") @db.Uuid
  state     String   @default("idle")
  draft     Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@unique([companyId, phone])
  @@map("whatsapp_sessions")
}

// Regra de aprovação (configurável, com default simples)
model ApprovalRule {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  departmentId String?  @map("department_id") @db.Uuid // null = vale pra toda empresa
  minValue     Decimal  @default(0) @map("min_value")
  maxValue     Decimal? @map("max_value") // null = sem limite superior
  stepOrder    Int      @map("step_order") // 1, 2, 3... (múltiplos níveis)
  approverId   String   @map("approver_id") @db.Uuid

  company    Company     @relation(fields: [companyId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  approver   User        @relation("RuleApprover", fields: [approverId], references: [id])

  @@map("approval_rules")
}

// rascunho, aguardando_aprovacao, aprovado, reprovado,
// em_cotacao, pedido_enviado, aguardando_entrega, aguardando_retirada, recebido, cancelado
model PurchaseRequest {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  requesterId    String   @map("requester_id") @db.Uuid
  departmentId   String?  @map("department_id") @db.Uuid
  title          String
  justification  String?
  urgency        String   @default("normal") // baixa, normal, alta, urgente
  estimatedTotal Decimal? @map("estimated_total")
  status         String   @default("aguardando_aprovacao")
  quoteDeadline  DateTime? @map("quote_deadline") // prazo pra fechar a cotação, opcional
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id])
  requester  User        @relation("Requester", fields: [requesterId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  items         PurchaseRequestItem[]
  approvalSteps ApprovalStep[]
  statusHistory StatusHistory[]
  notifications Notification[]
  quotes        Quote[]

  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                 String   @id @default(uuid()) @db.Uuid
  requestId          String   @map("request_id") @db.Uuid
  itemName           String   @map("item_name")
  quantity           Decimal
  unit               String? // un, kg, litro, saco...
  estimatedUnitPrice Decimal? @map("estimated_unit_price")
  notes              String?

  request PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("purchase_request_items")
}

// Cotações de fornecedores coletadas durante a fase "em_cotacao" do pedido
model Quote {
  id           String   @id @default(uuid()) @db.Uuid
  requestId    String   @map("request_id") @db.Uuid
  supplierId   String?  @map("supplier_id") @db.Uuid
  supplierName String   @map("supplier_name")
  totalPrice   Decimal  @map("total_price")
  freightValue Decimal? @map("freight_value")
  deliveryDays Int?     @map("delivery_days")
  notes        String?
  selected     Boolean  @default(false)
  createdById  String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  request     PurchaseRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  supplier    Supplier?         @relation(fields: [supplierId], references: [id])
  createdBy   User?             @relation(fields: [createdById], references: [id])
  attachments QuoteAttachment[]

  @@map("quotes")
}

// Arquivos anexados a uma cotação (print de orçamento, PDF de proposta, etc.)
model QuoteAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  quoteId      String   @map("quote_id") @db.Uuid
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  storageKey   String   @map("storage_key")
  uploadedById String?  @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  quote      Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@map("quote_attachments")
}

// Etapas de aprovação DO PEDIDO (cópia congelada da regra no momento da criação)
model ApprovalStep {
  id          String    @id @default(uuid()) @db.Uuid
  requestId   String    @map("request_id") @db.Uuid
  stepOrder   Int       @map("step_order")
  approverId  String    @map("approver_id") @db.Uuid
  status      String    @default("pendente") // pendente, aprovado, reprovado
  comment     String?
  decidedAt   DateTime? @map("decided_at")
  // Quem de fato clicou aprovar/reprovar — pode ser diferente de approverId quando
  // um admin decide no lugar do aprovador designado pela regra.
  decidedById String?   @map("decided_by_id") @db.Uuid

  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver  User            @relation("StepApprover", fields: [approverId], references: [id])
  decidedBy User?           @relation("StepDecidedBy", fields: [decidedById], references: [id])

  @@map("approval_steps")
}

// Histórico de status (auditoria / linha do tempo do pedido)
model StatusHistory {
  id         String   @id @default(uuid()) @db.Uuid
  requestId  String   @map("request_id") @db.Uuid
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  changedBy  String?  @map("changed_by") @db.Uuid
  note       String?
  changedAt  DateTime @default(now()) @map("changed_at")

  request       PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  changedByUser User?           @relation(fields: [changedBy], references: [id])

  @@map("status_history")
}

// Notificações enviadas (WhatsApp/e-mail)
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  requestId String?  @map("request_id") @db.Uuid
  channel   String? // whatsapp, email
  message   String?
  sentAt    DateTime @default(now()) @map("sent_at")

  user    User?            @relation(fields: [userId], references: [id])
  request PurchaseRequest? @relation(fields: [requestId], references: [id])

  @@map("notifications")
}

// Pedido de acesso à plataforma (lista de espera) — não cria empresa/usuário automaticamente
model AccessRequest {
  id          String   @id @default(uuid()) @db.Uuid
  companyName String   @map("company_name")
  contactName String   @map("contact_name")
  email       String
  phone       String?
  message     String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("access_requests")
}

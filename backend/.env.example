DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecom?schema=public"
# Se usar Neon (ou outro provedor com connection pooling), aponte DIRECT_URL para o endpoint
# sem "-pooler" no host — o Prisma Migrate precisa de uma conexão direta (não-pooled).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ecom?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
PORT=3000

# WhatsApp Cloud API (opcional). Sem essas variáveis, o bot funciona em modo stub
# (loga a resposta no console em vez de enviar de verdade) — dá pra testar o fluxo
# inteiro sem conta da Meta. Ver backend/README.md para o passo a passo de configuração.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
